generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  phone      String?
  // false = ממתינה לאישור סופר־אדמין אחרי הרשמה עצמית
  approved   Boolean  @default(false)
  active     Boolean  @default(true)
  // מודולי מכירה — סופר־אדמין מדליק לפי דרישה
  modInbound    Boolean @default(true) @map("mod_inbound") // קליטה
  modSales      Boolean @default(true) @map("mod_sales") // מכירה / ניפוק
  modPick       Boolean @default(true) @map("mod_pick") // ליקוט
  modCommerce   Boolean @default(false) @map("mod_commerce") // לקוחות / מחירונים
  modReturns    Boolean @default(false) @map("mod_returns") // החזרות RMA
  modTransfers  Boolean @default(false) @map("mod_transfers") // העברות בין מחסנים
  modShipments  Boolean @default(false) @map("mod_shipments") // משלוחים ואריזה
  modLots       Boolean @default(false) @map("mod_lots") // אצוות ותוקף
  modSerials    Boolean @default(false) @map("mod_serials") // סריאליים
  modKits       Boolean @default(false) @map("mod_kits") // קיטים והרכבה
  modReorder    Boolean @default(false) @map("mod_reorder") // הזמנות חוזרות
  modReportsPro Boolean @default(false) @map("mod_reports_pro") // דוחות פרימיום
  // תבנית ענף: fashion | food | auto_parts | garage
  industryProfile String?  @map("industry_profile")
  createdAt       DateTime @default(now()) @map("created_at")

  users                User[]
  categories           Category[]
  suppliers            Supplier[]
  products             Product[]
  productVariants      ProductVariant[]
  warehouses           Warehouse[]
  locations            WarehouseLocation[]
  pickLists            PickList[]
  pickTemplates        PickTemplate[]
  outboundTemplates    OutboundTemplate[]
  customFields         CustomField[]
  stockCounts          StockCountSession[]
  notifications        Notification[]
  purchaseOrders       PurchaseOrder[]
  salesOrders          SalesOrder[]
  inventoryLots        InventoryLot[]
  serialNumbers        SerialNumber[]
  waitlistItems        WaitlistItem[]
  stockDocuments       StockDocument[]
  customers            Customer[]
  inventoryBalances    InventoryBalance[]
  shipments            Shipment[]
  goodsReceipts        GoodsReceipt[]
  stockTransfers       StockTransfer[]
  returnAuthorizations ReturnAuthorization[]
  priceLists           PriceList[]
  attachments          Attachment[]
  reorderRules         ReorderRule[]

  @@map("companies")
}

model User {
  id                 String   @id @default(cuid())
  companyId          String   @map("company_id")
  name               String
  email              String?  @unique
  phone              String?  @unique
  passwordHash       String   @map("password_hash")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  role               String   @default("WAREHOUSE") // SUPER_ADMIN | ADMIN | WAREHOUSE | VIEWER
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  auditLogs            AuditLog[]
  pickLists            PickList[]
  stockCounts          StockCountSession[]
  productChanges       ProductChangeLog[]
  notifications        Notification[]        @relation("NotificationActor")
  goodsReceipts        GoodsReceipt[]
  stockTransfers       StockTransfer[]
  returnAuthorizations ReturnAuthorization[]
  attachments          Attachment[]

  @@index([companyId])
  @@index([phone])
  @@map("users")
}

model Category {
  id              String    @id @default(cuid())
  companyId       String    @map("company_id")
  name            String
  hasVariants     Boolean   @default(false) @map("has_variants")
  attributeSchema String    @default("[]") @map("attribute_schema")
  products        Product[]
  createdAt       DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("categories")
}

model Supplier {
  id             String          @id @default(cuid())
  companyId      String          @map("company_id")
  name           String
  products       Product[]
  purchaseOrders PurchaseOrder[]
  reorderRules   ReorderRule[]
  createdAt      DateTime        @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("suppliers")
}

model Product {
  id             String   @id @default(cuid())
  companyId      String   @map("company_id")
  categoryId     String   @map("category_id")
  title          String
  baseSku        String   @map("base_sku")
  description    String?
  supplierId     String?  @map("supplier_id")
  costPrice      Float    @default(0) @map("cost_price")
  sellingPrice   Float    @default(0) @map("selling_price")
  unitOfMeasure  String   @default("UNIT") @map("unit_of_measure") // UNIT | CARTON | SQM | KG | LITER | METER | PAIR | SET
  unitsPerCarton Int      @default(1) @map("units_per_carton")
  weightKg       Float?   @map("weight_kg")
  volumeLiters   Float?   @map("volume_liters")
  trackLots      Boolean  @default(false) @map("track_lots")
  trackSerials   Boolean  @default(false) @map("track_serials")
  isKit          Boolean  @default(false) @map("is_kit")
  customData     String   @default("{}") @map("custom_data") // JSON: { [fieldKey]: value }
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      Category           @relation(fields: [categoryId], references: [id])
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  variants      ProductVariant[]
  changes       ProductChangeLog[]
  kitComponents KitComponent[]     @relation("KitProduct")

  @@unique([companyId, baseSku])
  @@index([categoryId])
  @@index([supplierId])
  @@index([title])
  @@index([companyId])
  @@map("products")
}

model CustomField {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  entityType String   @default("PRODUCT") @map("entity_type") // PRODUCT
  key        String
  label      String
  fieldType  String   @default("TEXT") @map("field_type") // TEXT | NUMBER | DATE | SELECT | BOOLEAN
  options    String   @default("[]") // JSON string array for SELECT
  required   Boolean  @default(false)
  sortOrder  Int      @default(0) @map("sort_order")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, entityType, key])
  @@index([companyId, entityType, active])
  @@map("custom_fields")
}

model OutboundTemplate {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  name        String
  notes       String?
  reasonCode  String   @default("SALE") @map("reason_code")
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   OutboundTemplateItem[]

  @@index([companyId])
  @@map("outbound_templates")
}

model OutboundTemplateItem {
  id         String @id @default(cuid())
  templateId String @map("template_id")
  variantId  String @map("variant_id")
  quantity   Int

  template OutboundTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  variant  ProductVariant   @relation(fields: [variantId], references: [id])

  @@unique([templateId, variantId])
  @@index([templateId])
  @@map("outbound_template_items")
}

model Warehouse {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  name      String
  code      String
  address   String?
  isDefault Boolean  @default(false) @map("is_default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locations     WarehouseLocation[]
  transfersFrom StockTransfer[]     @relation("TransferFromWarehouse")
  transfersTo   StockTransfer[]     @relation("TransferToWarehouse")

  @@unique([companyId, code])
  @@index([companyId, active])
  @@map("warehouses")
}

model WarehouseLocation {
  id            String              @id @default(cuid())
  companyId     String              @map("company_id")
  warehouseId   String?             @map("warehouse_id")
  zone          String
  aisle         String
  shelf         String
  bin           String
  code          String
  variants      ProductVariant[]
  lots          InventoryLot[]
  serials       SerialNumber[]
  balances      InventoryBalance[]
  transfersFrom StockTransferLine[] @relation("TransferFromLocation")
  transfersTo   StockTransferLine[] @relation("TransferToLocation")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@unique([companyId, code])
  @@index([zone])
  @@index([shelf])
  @@index([companyId])
  @@index([warehouseId])
  @@map("warehouse_locations")
}

model ProductVariant {
  id               String   @id @default(cuid())
  companyId        String   @map("company_id")
  productId        String   @map("product_id")
  sku              String
  barcode          String
  attributes       String   @default("{}")
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  minAlertLevel    Int      @default(5) @map("min_alert_level")
  locationId       String?  @map("location_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product               Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  location              WarehouseLocation?        @relation(fields: [locationId], references: [id])
  transactions          StockTransaction[]
  pickItems             PickListItem[]
  templateItems         PickTemplateItem[]
  outboundTemplateItems OutboundTemplateItem[]
  countLines            StockCountLine[]
  lots                  InventoryLot[]
  serials               SerialNumber[]
  poLines               PurchaseOrderLine[]
  soLines               SalesOrderLine[]
  waitlistItems         WaitlistItem[]
  kitAsComponent        KitComponent[]            @relation("KitComponentVariant")
  balances              InventoryBalance[]
  priceListItems        PriceListItem[]
  customerPrices        CustomerPrice[]
  goodsReceiptLines     GoodsReceiptLine[]
  transferLines         StockTransferLine[]
  rmaLines              ReturnAuthorizationLine[]
  shipmentPackageItems  ShipmentPackageItem[]
  reorderRules          ReorderRule[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([productId])
  @@index([companyId])
  @@index([barcode])
  @@index([sku])
  @@index([locationId])
  @@map("product_variants")
}

model KitComponent {
  id                 String @id @default(cuid())
  kitProductId       String @map("kit_product_id")
  componentVariantId String @map("component_variant_id")
  quantity           Int    @default(1)

  kitProduct       Product        @relation("KitProduct", fields: [kitProductId], references: [id], onDelete: Cascade)
  componentVariant ProductVariant @relation("KitComponentVariant", fields: [componentVariantId], references: [id])

  @@unique([kitProductId, componentVariantId])
  @@index([kitProductId])
  @@map("kit_components")
}

model InventoryLot {
  id         String    @id @default(cuid())
  companyId  String    @map("company_id")
  variantId  String    @map("variant_id")
  lotCode    String    @map("lot_code")
  expiryDate DateTime? @map("expiry_date")
  quantity   Int       @default(0)
  locationId String?   @map("location_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variant  ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location WarehouseLocation? @relation(fields: [locationId], references: [id])
  serials  SerialNumber[]
  txns     StockTransaction[]

  @@unique([companyId, variantId, lotCode, locationId])
  @@index([companyId, expiryDate])
  @@index([variantId])
  @@map("inventory_lots")
}

model SerialNumber {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  variantId  String   @map("variant_id")
  serial     String
  status     String   @default("IN_STOCK") // IN_STOCK | SOLD | RETURNED | DAMAGED
  lotId      String?  @map("lot_id")
  locationId String?  @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variant  ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  lot      InventoryLot?      @relation(fields: [lotId], references: [id])
  location WarehouseLocation? @relation(fields: [locationId], references: [id])
  txns     StockTransaction[]

  @@unique([companyId, serial])
  @@index([variantId, status])
  @@map("serial_numbers")
}

model PurchaseOrder {
  id            String    @id @default(cuid())
  companyId     String    @map("company_id")
  supplierId    String?   @map("supplier_id")
  number        String
  status        String    @default("DRAFT") // DRAFT | ORDERED | PARTIAL | RECEIVED | CANCELLED
  invoiceNumber String?   @map("invoice_number")
  notes         String?
  expectedAt    DateTime? @map("expected_at")
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier  Supplier?           @relation(fields: [supplierId], references: [id])
  lines     PurchaseOrderLine[]
  documents StockDocument[]
  receipts  GoodsReceipt[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id          String @id @default(cuid())
  poId        String @map("po_id")
  variantId   String @map("variant_id")
  qtyOrdered  Int    @map("qty_ordered")
  qtyReceived Int    @default(0) @map("qty_received")
  unitCost    Float  @default(0) @map("unit_cost")

  po           PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  variant      ProductVariant     @relation(fields: [variantId], references: [id])
  receiptLines GoodsReceiptLine[]

  @@unique([poId, variantId])
  @@index([poId])
  @@map("purchase_order_lines")
}

model SalesOrder {
  id              String    @id @default(cuid())
  companyId       String    @map("company_id")
  number          String
  customerId      String?   @map("customer_id")
  customerName    String    @map("customer_name")
  customerPhone   String?   @map("customer_phone")
  status          String    @default("OPEN") // OPEN | PARTIAL | FULFILLED | PACKED | SHIPPED | CANCELLED
  priority        Int       @default(3) // 1=גבוה … 5=נמוך
  slaDueAt        DateTime? @map("sla_due_at")
  vatRate         Float     @default(17) @map("vat_rate")
  discountTiers   String    @default("[]") @map("discount_tiers") // JSON [{minQty, percent}] — deprecated: prefer PriceList
  priceListId     String?   @map("price_list_id")
  shippingCarrier String?   @map("shipping_carrier")
  shippingRef     String?   @map("shipping_ref")
  notes           String?
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer             Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  priceList            PriceList?            @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  lines                SalesOrderLine[]
  documents            StockDocument[]
  shipments            Shipment[]
  returnAuthorizations ReturnAuthorization[]

  @@unique([companyId, number])
  @@index([companyId, status, priority])
  @@index([slaDueAt])
  @@index([customerId])
  @@index([priceListId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String @id @default(cuid())
  orderId      String @map("order_id")
  variantId    String @map("variant_id")
  qtyOrdered   Int    @map("qty_ordered")
  qtyFulfilled Int    @default(0) @map("qty_fulfilled")
  unitPrice    Float  @default(0) @map("unit_price")

  order   SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([orderId, variantId])
  @@index([orderId])
  @@map("sales_order_lines")
}

model WaitlistItem {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  variantId    String   @map("variant_id")
  customerId   String?  @map("customer_id")
  quantity     Int
  customerName String?  @map("customer_name")
  notes        String?
  status       String   @default("OPEN") // OPEN | NOTIFIED | FULFILLED | CANCELLED
  createdAt    DateTime @default(now()) @map("created_at")

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])
  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([variantId])
  @@index([customerId])
  @@map("waitlist_items")
}

model StockDocument {
  id              String   @id @default(cuid())
  companyId       String   @map("company_id")
  type            String // INVOICE | DELIVERY_NOTE | CREDIT_NOTE | RMA
  number          String
  purchaseOrderId String?  @map("purchase_order_id")
  salesOrderId    String?  @map("sales_order_id")
  payloadJson     String   @default("{}") @map("payload_json")
  subtotal        Float    @default(0)
  vatAmount       Float    @default(0) @map("vat_amount")
  total           Float    @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  salesOrder    SalesOrder?    @relation(fields: [salesOrderId], references: [id])

  @@unique([companyId, type, number])
  @@index([companyId, type])
  @@map("stock_documents")
}

model StockTransaction {
  id               String   @id @default(cuid())
  variantId        String   @map("variant_id")
  type             String
  quantityChanged  Int      @map("quantity_changed")
  previousQuantity Int      @map("previous_quantity")
  newQuantity      Int      @map("new_quantity")
  reason           String
  reasonCode       String?  @map("reason_code") // SALE | WASTE | RETURN | DAMAGE | OTHER | COUNT | ...
  fromLocationId   String?  @map("from_location_id")
  toLocationId     String?  @map("to_location_id")
  userId           String?  @map("user_id")
  lotId            String?  @map("lot_id")
  serialId         String?  @map("serial_id")
  correctedTxnId   String?  @map("corrected_txn_id")
  purchaseOrderId  String?  @map("purchase_order_id")
  salesOrderId     String?  @map("sales_order_id")
  timestamp        DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  lot     InventoryLot?  @relation(fields: [lotId], references: [id])
  serial  SerialNumber?  @relation(fields: [serialId], references: [id])

  @@index([variantId])
  @@index([timestamp])
  @@index([type])
  @@index([reasonCode])
  @@index([lotId])
  @@index([salesOrderId])
  @@index([purchaseOrderId])
  @@map("stock_transactions")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    String   @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model ProductChangeLog {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  userId    String?  @map("user_id")
  field     String
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@map("product_change_logs")
}

model PickTemplate {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  name        String
  notes       String?
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items     PickTemplateItem[]
  pickLists PickList[]

  @@index([companyId])
  @@map("pick_templates")
}

model PickTemplateItem {
  id         String @id @default(cuid())
  templateId String @map("template_id")
  variantId  String @map("variant_id")
  quantity   Int

  template PickTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([templateId, variantId])
  @@index([templateId])
  @@map("pick_template_items")
}

model PickList {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  templateId  String?  @map("template_id")
  reference   String
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | DONE | CANCELLED
  notes       String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template  PickTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy User?          @relation(fields: [createdById], references: [id])
  items     PickListItem[]

  @@index([status])
  @@index([companyId])
  @@index([templateId])
  @@map("pick_lists")
}

model PickListItem {
  id         String @id @default(cuid())
  pickListId String @map("pick_list_id")
  variantId  String @map("variant_id")
  quantity   Int
  pickedQty  Int    @default(0) @map("picked_qty")
  status     String @default("PENDING") // PENDING | DONE

  pickList PickList       @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([pickListId])
  @@map("pick_list_items")
}

model StockCountSession {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  name        String
  zone        String?
  shelf       String?
  status      String    @default("OPEN") // OPEN | CLOSED
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  closedAt    DateTime? @map("closed_at")

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?            @relation(fields: [createdById], references: [id])
  lines     StockCountLine[]

  @@index([companyId])
  @@map("stock_count_sessions")
}

model StockCountLine {
  id         String @id @default(cuid())
  sessionId  String @map("session_id")
  variantId  String @map("variant_id")
  systemQty  Int    @map("system_qty")
  countedQty Int?   @map("counted_qty")
  variance   Int?

  session StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  variant ProductVariant    @relation(fields: [variantId], references: [id])

  @@unique([sessionId, variantId])
  @@map("stock_count_lines")
}

model Notification {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  type      String // LOW_STOCK | DEAD_STOCK | COUNT_VARIANCE | PICK_READY | SYSTEM
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation("NotificationActor", fields: [userId], references: [id])

  @@index([companyId, read, createdAt])
  @@map("notifications")
}

model Customer {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  name        String
  phone       String?
  email       String?
  address     String?
  taxId       String?  @map("tax_id")
  creditLimit Float?   @map("credit_limit")
  priceListId String?  @map("price_list_id")
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceList            PriceList?            @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  salesOrders          SalesOrder[]
  waitlistItems        WaitlistItem[]
  customerPrices       CustomerPrice[]
  returnAuthorizations ReturnAuthorization[]

  @@index([companyId, active])
  @@index([companyId, name])
  @@index([phone])
  @@index([priceListId])
  @@map("customers")
}

model InventoryBalance {
  id               String   @id @default(cuid())
  companyId        String   @map("company_id")
  variantId        String   @map("variant_id")
  locationId       String   @map("location_id")
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variant  ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationId])
  @@index([companyId, variantId])
  @@index([locationId])
  @@map("inventory_balances")
}

model Shipment {
  id           String    @id @default(cuid())
  companyId    String    @map("company_id")
  salesOrderId String    @map("sales_order_id")
  number       String
  status       String    @default("DRAFT") // DRAFT | PACKED | SHIPPED | DELIVERED | CANCELLED
  carrier      String?
  trackingRef  String?   @map("tracking_ref")
  shippedAt    DateTime? @map("shipped_at")
  deliveredAt  DateTime? @map("delivered_at")
  notes        String?
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  packages   ShipmentPackage[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([salesOrderId])
  @@map("shipments")
}

model ShipmentPackage {
  id          String  @id @default(cuid())
  shipmentId  String  @map("shipment_id")
  label       String?
  weightKg    Float?  @map("weight_kg")
  lengthCm    Float?  @map("length_cm")
  widthCm     Float?  @map("width_cm")
  heightCm    Float?  @map("height_cm")
  trackingRef String? @map("tracking_ref")

  shipment Shipment              @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  items    ShipmentPackageItem[]

  @@index([shipmentId])
  @@map("shipment_packages")
}

model ShipmentPackageItem {
  id        String @id @default(cuid())
  packageId String @map("package_id")
  variantId String @map("variant_id")
  quantity  Int    @default(1)

  package ShipmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id])

  @@unique([packageId, variantId])
  @@index([packageId])
  @@map("shipment_package_items")
}

model GoodsReceipt {
  id              String    @id @default(cuid())
  companyId       String    @map("company_id")
  purchaseOrderId String    @map("purchase_order_id")
  number          String
  status          String    @default("DRAFT") // DRAFT | PARTIAL | COMPLETED | CANCELLED
  receivedAt      DateTime? @map("received_at")
  notes           String?
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  createdBy     User?              @relation(fields: [createdById], references: [id])
  lines         GoodsReceiptLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id          String  @id @default(cuid())
  receiptId   String  @map("receipt_id")
  poLineId    String? @map("po_line_id")
  variantId   String  @map("variant_id")
  qtyExpected Int     @default(0) @map("qty_expected")
  qtyReceived Int     @default(0) @map("qty_received")
  qtyDamaged  Int     @default(0) @map("qty_damaged")
  notes       String?

  receipt GoodsReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLine  PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)
  variant ProductVariant     @relation(fields: [variantId], references: [id])

  @@index([receiptId])
  @@index([poLineId])
  @@map("goods_receipt_lines")
}

model StockTransfer {
  id              String    @id @default(cuid())
  companyId       String    @map("company_id")
  number          String
  status          String    @default("DRAFT") // DRAFT | IN_TRANSIT | RECEIVED | CANCELLED
  fromWarehouseId String?   @map("from_warehouse_id")
  toWarehouseId   String?   @map("to_warehouse_id")
  notes           String?
  shippedAt       DateTime? @map("shipped_at")
  receivedAt      DateTime? @map("received_at")
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse?          @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse?          @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])
  createdBy     User?               @relation(fields: [createdById], references: [id])
  lines         StockTransferLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id             String  @id @default(cuid())
  transferId     String  @map("transfer_id")
  variantId      String  @map("variant_id")
  fromLocationId String? @map("from_location_id")
  toLocationId   String? @map("to_location_id")
  qtyRequested   Int     @map("qty_requested")
  qtyShipped     Int     @default(0) @map("qty_shipped")
  qtyReceived    Int     @default(0) @map("qty_received")

  transfer     StockTransfer      @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant      ProductVariant     @relation(fields: [variantId], references: [id])
  fromLocation WarehouseLocation? @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocation   WarehouseLocation? @relation("TransferToLocation", fields: [toLocationId], references: [id])

  @@index([transferId])
  @@index([variantId])
  @@map("stock_transfer_lines")
}

model ReturnAuthorization {
  id           String    @id @default(cuid())
  companyId    String    @map("company_id")
  salesOrderId String?   @map("sales_order_id")
  customerId   String?   @map("customer_id")
  number       String
  status       String    @default("OPEN") // OPEN | RECEIVED | INSPECTED | CREDITED | REJECTED | CANCELLED
  reason       String?
  reasonCode   String?   @map("reason_code") // DAMAGE | WRONG_ITEM | CUSTOMER_CHANGE | OTHER
  creditAmount Float?    @map("credit_amount")
  notes        String?
  createdById  String?   @map("created_by_id")
  receivedAt   DateTime? @map("received_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company    Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder?               @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  customer   Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy  User?                     @relation(fields: [createdById], references: [id])
  lines      ReturnAuthorizationLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([salesOrderId])
  @@index([customerId])
  @@map("return_authorizations")
}

model ReturnAuthorizationLine {
  id           String  @id @default(cuid())
  rmaId        String  @map("rma_id")
  variantId    String  @map("variant_id")
  qtyRequested Int     @map("qty_requested")
  qtyReceived  Int     @default(0) @map("qty_received")
  condition    String  @default("UNKNOWN") // UNKNOWN | SELLABLE | DAMAGED | REFURBISH
  restock      Boolean @default(true)
  notes        String?

  rma     ReturnAuthorization @relation(fields: [rmaId], references: [id], onDelete: Cascade)
  variant ProductVariant      @relation(fields: [variantId], references: [id])

  @@index([rmaId])
  @@map("return_authorization_lines")
}

model PriceList {
  id        String    @id @default(cuid())
  companyId String    @map("company_id")
  name      String
  currency  String    @default("ILS")
  active    Boolean   @default(true)
  validFrom DateTime? @map("valid_from")
  validTo   DateTime? @map("valid_to")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items     PriceListItem[]
  customers Customer[]
  orders    SalesOrder[]

  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("price_lists")
}

model PriceListItem {
  id          String @id @default(cuid())
  priceListId String @map("price_list_id")
  variantId   String @map("variant_id")
  unitPrice   Float  @map("unit_price")
  minQty      Int    @default(1) @map("min_qty")

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId, minQty])
  @@index([priceListId])
  @@index([variantId])
  @@map("price_list_items")
}

model CustomerPrice {
  id         String @id @default(cuid())
  customerId String @map("customer_id")
  variantId  String @map("variant_id")
  unitPrice  Float  @map("unit_price")
  minQty     Int    @default(1) @map("min_qty")

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([customerId, variantId, minQty])
  @@index([customerId])
  @@index([variantId])
  @@map("customer_prices")
}

model Attachment {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  entityType   String   @map("entity_type") // PRODUCT | PURCHASE_ORDER | SALES_ORDER | RMA | STOCK_COUNT | GOODS_RECEIPT | OTHER
  entityId     String   @map("entity_id")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @default(0) @map("size_bytes")
  storageKey   String   @map("storage_key") // blob path / URL key
  url          String?
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id])

  @@index([companyId, entityType, entityId])
  @@index([uploadedById])
  @@map("attachments")
}

model ReorderRule {
  id              String   @id @default(cuid())
  companyId       String   @map("company_id")
  variantId       String   @map("variant_id")
  minQty          Int      @map("min_qty")
  maxQty          Int?     @map("max_qty")
  reorderQty      Int      @map("reorder_qty")
  supplierId      String?  @map("supplier_id")
  leadTimeDays    Int?     @map("lead_time_days")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([companyId, variantId])
  @@index([companyId, active])
  @@index([supplierId])
  @@map("reorder_rules")
}
