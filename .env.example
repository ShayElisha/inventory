# Neon / Postgres connection string (Vercel Storage → Neon)
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# חובה בפרודקשן — מחרוזת אקראית ארוכה (למשל: openssl rand -base64 48)
AUTH_SECRET=

# אורך session בימים (ברירת מחדל 7, מקסימום 30)
# SESSION_DAYS=7

# סופר־אדמין (חובה בפרודקשן על Vercel — נוצר/מסונכרן בהתחברות)
# SUPER_ADMIN_EMAIL=you@example.com
# SUPER_ADMIN_PASSWORD=

# זריעת משתמשי דמו (admin@inventory.local וכו׳). בפרודקשן כבוי כברירת מחדל.
# ALLOW_DEMO_SEED=true

# כיבוי הרשמה ציבורית (חברות חדשות רק דרך סופר־אדמין)
# DISABLE_PUBLIC_REGISTER=true

# Upstash Redis — rate limit מבוזר בין instances
# (Vercel Marketplace → Upstash for Redis → upstash/upstash-kv)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Sentry — ניטור שגיאות (Marketplace → Sentry)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
